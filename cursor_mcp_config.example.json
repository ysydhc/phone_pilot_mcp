{
  "mcpServers": {
    "// 方式一：uvx（推荐，无需安装）": {},
    "phone_pilot": {
      "command": "uvx",
      "args": ["phone-pilot-mcp"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },

    "// 方式二：pip install 后直接使用": {},
    "phone_pilot_installed": {
      "command": "phone-pilot-mcp",
      "args": [],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },

    "// 方式三：开发模式（本地源码）": {},
    "phone_pilot_dev": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "<PROJECT_PATH>",
        "phone-pilot-mcp"
      ],
      "cwd": "<PROJECT_PATH>",
      "env": {
        "ADB_PATH": "<ANDROID_SDK>/platform-tools/adb",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
