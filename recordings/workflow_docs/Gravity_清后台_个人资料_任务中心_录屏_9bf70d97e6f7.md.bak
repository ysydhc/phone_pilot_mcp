# Gravity_清后台_个人资料_任务中心_录屏
清后台 → 打开 Gravity → 图像点击个人资料 → 图像点击任务中心，全程录屏；点击步骤带重试校验。
```json
{
  "name": "Gravity_清后台_个人资料_任务中心_录屏",
  "device_serial": null,
  "out_dir": "/Users/yeshouyou/Work/agent/phone_touch/recordings",
  "steps": [
    {
      "type": "set_options",
      "values": {
        "fail_fast": true,
        "retry_max_attempts": 3,
        "retry_delay_s": 1
      }
    },
    {
      "type": "clear_background_processes",
      "name": "清除后台(三方App)",
      "mode": "force_stop_3p",
      "run_kill_all_first": true,
      "max_packages": 400
    },
    {
      "type": "ensure_launch",
      "name": "打开Gravity(默认避开LeakCanary)",
      "query": "Gravity",
      "reset_home": true,
      "home_presses": 2,
      "wait_s": 1.2
    },
    {
      "type": "sleep",
      "name": "等待首页稳定",
      "seconds": 1
    },
    {
      "type": "find_image_and_tap",
      "name": "点击个人资料(图1)",
      "template_path": "/Users/yeshouyou/Work/agent/phone_touch/recordings/templates/gravity_个人资料_4765a2b3ab23.png",
      "threshold": 0.85,
      "grayscale": true,
      "match_index": 0,
      "pre_screenshot": true,
      "post_screenshot": true,
      "verify": {
        "type": "find_image_on_screen",
        "name": "验证任务中心入口已出现(确认进入个人资料页)",
        "template_path": "/Users/yeshouyou/Work/agent/phone_touch/recordings/templates/gravity_任务中心_a33aa7282070.png",
        "threshold": 0.82,
        "grayscale": true,
        "max_results": 3
      }
    },
    {
      "type": "sleep",
      "name": "等待个人资料页加载",
      "seconds": 1
    },
    {
      "type": "find_image_and_tap",
      "name": "点击任务中心(图2)",
      "template_path": "/Users/yeshouyou/Work/agent/phone_touch/recordings/templates/gravity_任务中心_a33aa7282070.png",
      "threshold": 0.85,
      "grayscale": true,
      "match_index": 0,
      "pre_screenshot": true,
      "post_screenshot": true
    },
    {
      "type": "sleep",
      "name": "等待跳转任务中心",
      "seconds": 1.2
    },
    {
      "type": "collect_artifacts",
      "name": "采集focus并做结果校验",
      "include_focus": true,
      "include_screenshot": true
    },
    {
      "type": "assert",
      "name": "断言进入任务中心(按需改Activity关键字)",
      "expr": "'TaskCenter' in (last.focused_activity or '')",
      "message": "未检测到进入任务中心页面：focused_activity 不包含 'TaskCenter'",
      "fatal": true
    }
  ],
  "clear_logcat_first": true,
  "final_collect_artifacts": true,
  "logcat_lines": 8000
}
```
