# 设置-搜索-进入开发者选项
通过 android_touch：清后台→打开设置→点击"搜索系统设置项"→输入法输入"开发者模式"（本机型用拼音 kaifazhemoshi 等价）→点击"开发者选项"。
```json
{
  "name": "设置-搜索-进入开发者选项",
  "device_serial": "98e516bf0922",
  "out_dir": "./recordings",
  "steps": [
    {
      "type": "clear_background_processes",
      "mode": "force_stop_3p",
      "run_kill_all_first": true,
      "exclude_packages": [
        "com.android.settings"
      ]
    },
    {
      "type": "restart_app",
      "name": "open_settings",
      "package": "com.android.settings",
      "force_stop": true,
      "wait_s": 1.2
    },
    {
      "type": "sleep",
      "seconds": 0.8
    },
    {
      "type": "find_and_tap",
      "name": "open_search_page",
      "query": "搜索系统设置项",
      "exact": false,
      "scroll_on_fail": false,
      "pre_screenshot": true,
      "post_screenshot": true
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "input_text",
      "name": "type_pinyin_kaifazhemoshi",
      "text": "kaifazhemoshi",
      "enter": false,
      "wait_s": 0.2
    },
    {
      "type": "sleep",
      "seconds": 0.8
    },
    {
      "type": "find_and_tap",
      "name": "open_developer_options",
      "query": "开发者选项",
      "exact": false,
      "scroll_on_fail": false,
      "pre_screenshot": true,
      "post_screenshot": true
    },
    {
      "type": "sleep",
      "seconds": 0.8
    },
    {
      "type": "screenshot",
      "name": "developer_options_page"
    }
  ],
  "clear_logcat_first": true,
  "final_collect_artifacts": true,
  "logcat_lines": 8000
}
```
