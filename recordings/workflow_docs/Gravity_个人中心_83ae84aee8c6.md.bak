# Gravity_个人中心
清后台 → 通用启动（优先用已记录的 component 启动；没有则从桌面找图标启动并自动记录）→ 点击右下角 個人資料（个人中心/个人资料）

说明：这是一个“通用可复用”的启动策略（自学习）：第一次可能需要从桌面找图标；成功后会记录启动 Activity，下次直接用 `adb shell am start -n <component>` 启动。
```json
{
  "name": "Gravity_个人中心",
  "device_serial": "98e516bf0922",
  "out_dir": "./recordings",
  "steps": [
    {
      "type": "clear_background_processes",
      "mode": "force_stop_3p",
      "run_kill_all_first": true,
      "max_packages": 400
    },
    {
      "type": "ensure_launch",
      "query": "GRAVITY",
      "package": "anonymous.sns.community.gravity",
      "reset_home": true,
      "home_presses": 2,
      "max_swipes": 10,
      "directions": ["left", "right"],
      "stuck_threshold": 2,
      "tap_offset_y": -160,
      "wait_s": 1.2,
      "save_profile": true
    },
    {
      "type": "sleep",
      "seconds": 1.2
    },
    {
      "type": "screenshot",
      "name": "after_open"
    },
    {
      "type": "find_and_tap",
      "query": "個人資料",
      "exact": true,
      "match_index": 0,
      "pre_screenshot": true,
      "post_screenshot": true,
      "name": "tap_profile"
    },
    {
      "type": "collect_artifacts",
      "name": "final"
    }
  ],
  "clear_logcat_first": true,
  "final_collect_artifacts": true,
  "logcat_lines": 8000
}
```
