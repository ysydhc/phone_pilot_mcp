# Gravity_清后台_回桌面_打开App_点击tvCenter_v2
修正版：set_options 格式正确；find_and_tap 的 verify 使用 verify 支持的 find_on_screen（避免 unsupported_verify_type）。
```json
{
  "name": "Gravity_清后台_回桌面_打开App_点击tvCenter_v2",
  "device_serial": "98e516bf0922",
  "out_dir": "/Users/yeshouyou/Work/agent/phone_touch/recordings",
  "steps": [
    {
      "type": "set_options",
      "values": {
        "fail_fast": true,
        "retry_max_attempts": 3,
        "retry_delay_s": 0.6
      }
    },
    {
      "type": "clear_background_processes",
      "mode": "force_stop_3p",
      "exclude_packages": [],
      "max_packages": 400,
      "run_kill_all_first": true
    },
    {
      "type": "reset_home",
      "home_presses": 2
    },
    {
      "type": "ensure_launch",
      "query": "Gravity",
      "package": "anonymous.sns.community.gravity",
      "reset_home": false,
      "home_presses": 2,
      "max_swipes": 12,
      "wait_s": 1.5
    },
    {
      "type": "wait_for_focus",
      "package": "anonymous.sns.community.gravity",
      "timeout_s": 12,
      "interval_s": 0.35
    },
    {
      "type": "dismiss_popups",
      "name": "post_launch_dismiss",
      "max_rounds": 2,
      "max_taps": 6,
      "settle_s": 0.35,
      "post_screenshot": true
    },
    {
      "type": "wait_for_ui",
      "query": "anonymous.sns.community.gravity:id/tvCenter",
      "field": "resource_id",
      "exact": true,
      "timeout_s": 10,
      "interval_s": 0.35
    },
    {
      "type": "find_and_tap",
      "name": "tap_tvCenter",
      "query": "anonymous.sns.community.gravity:id/tvCenter",
      "field": "resource_id",
      "exact": true,
      "scroll_on_fail": false,
      "pre_screenshot": true,
      "post_screenshot": true,
      "verify": [
        {
          "type": "find_on_screen",
          "query": "anonymous.sns.community.gravity:id/tvCenter",
          "field": "resource_id",
          "exact": true,
          "timeout_s": 6,
          "interval_s": 0.35
        }
      ]
    },
    {
      "type": "screenshot",
      "name": "after_tap_tvCenter"
    }
  ],
  "clear_logcat_first": true,
  "final_collect_artifacts": true,
  "logcat_lines": 8000
}
```
