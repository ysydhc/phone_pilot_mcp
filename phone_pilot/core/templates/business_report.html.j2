<style>
.storyboard{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}.story-screen{width:100%;height:280px;object-fit:contain;background:#111827}.business-layout{display:grid;grid-template-columns:190px 1fr;gap:20px}.business-nav{position:sticky;top:60px;align-self:start}.business-nav a{display:block;padding:10px;border-bottom:1px solid var(--border)}.business-step{scroll-margin-top:70px;margin-bottom:24px;border:1px solid var(--border);border-radius:12px;padding:18px}.attempt-grid{display:grid;grid-template-columns:minmax(180px,320px) 1fr;gap:20px}.full-screen{width:100%;max-height:650px;object-fit:contain;background:#111827}.business-step pre{white-space:pre-wrap;word-break:break-word;max-height:300px;overflow:auto;background:#111827;color:#eee;padding:12px}.assertions td{vertical-align:top;overflow-wrap:anywhere}.assertions td:nth-child(3){white-space:nowrap}.assertions{table-layout:auto}.missing{color:#b45309}.restore-result{white-space:pre-wrap;overflow-wrap:anywhere}.restore-panel input{max-width:100%;padding:8px} @media(max-width:700px){.business-layout,.attempt-grid{grid-template-columns:1fr}.business-nav{position:static}.storyboard{grid-template-columns:repeat(2,minmax(0,1fr))}.assertions{display:block;overflow:auto}} @media print{.business-nav,.restore-panel button{display:none}.business-step{break-inside:avoid}}
</style>
<section class="section restore-panel" id="scene-restore" data-run-name="{{ run_name }}">
<h2>一键复原设备现场</h2>
<p>重建受限 Android 离线 Demo 的<strong>语义目标状态</strong>；不是打开历史截图、播放录像，也不恢复内存或远端历史。</p>
<p>当前计划：<strong>{{ scene.status }}</strong>。READY 仅表示本地 manifest 合法，尚未验证设备。默认禁止设备写入。</p>
{% for blocker in scene.blockers %}<p class="missing">{{ blocker.code }}：{{ blocker.message }}</p>{% endfor %}
<p>首版要求已装匹配、无权限需求的 Debug APK，设备已离线；需要配置/Mock、外部服务、权限修改或不可逆副作用时停止。</p>
<label>显式设备 <input id="scene-serial" placeholder="填写已批准 manifest 的 serial" autocomplete="off"></label>
<button type="button" id="scene-button" class="btn-sm">检查并复原现场</button>
<p id="scene-result" class="restore-result">离线文件仅可查看；执行需本机 dashboard 使用 --approve-scene-sha256 明确启用审阅后的 manifest。</p>
</section>
{% if business %}
<section class="section" id="business-overview"><h2>功能全景 · 业务判定 {{ business.summary.status }}</h2>
<p>执行退出码 {{ meta.exit_code }} 单独记录，不代表业务通过。首轮 {{ (business.summary.first_pass_rate * 100)|round(1) }}% · 最终完成 {{ (business.summary.final_completion_rate * 100)|round(1) }}% · 证据完整 {{ (business.summary.evidence_complete_rate * 100)|round(1) }}%（声明 {{ business.summary.planned_steps }} 步）。</p>
<div class="storyboard">{% for step in business.steps %}<a href="#{{ step.anchor }}">{% if step.screens %}<img class="story-screen" src="{{ step.screens[-1].url }}" alt="{{ step.title }}完整屏幕">{% else %}<div class="story-screen missing">未采集完整屏幕</div>{% endif %}<strong>{{ step.title }}</strong><p>{{ step.first_result }} → {{ step.final_result }} {{ step.recovery_status }}</p></a>{% endfor %}</div>
</section>
<section class="section" id="business-steps"><h2>逐步骤验收 · 原始失败与每次尝试</h2><div class="business-layout">
<nav class="business-nav">{% for step in business.steps %}<a href="#{{ step.anchor }}">{{ step.title }} · {{ step.final_result }}</a>{% endfor %}</nav>
<div>{% for step in business.steps %}<article class="business-step" id="{{ step.anchor }}"><h3>{{ step.case_id }} / {{ step.business_step_id }} · {{ step.title }}</h3>
<p>首次 {{ step.first_result }} · 最终 {{ step.final_result }} {% if step.recovery_status %}<strong>{{ step.recovery_status }}（保留首次失败）</strong>{% endif %}</p>
{% if not step.attempts %}<p class="missing">NOT_RUN：声明步骤未执行，不从分母移除。</p>{% endif %}
{% for attempt in step.attempts %}<details open><summary>{{ attempt.attempt_id }} · {{ attempt.status }} · {{ attempt.duration_ms }} ms</summary><p>{{ attempt.started_at }} → {{ attempt.finished_at }} · 环境 {{ attempt.environment_ref or 'unknown' }}</p><div class="attempt-grid">
<div>{% for e in attempt.display_evidence if e.is_image %}{% if e.available %}<a href="{{ e.url }}"><img class="full-screen" src="{{ e.url }}" alt="{{ e.evidence_id }}原始全屏"></a>{% else %}<p class="missing">{{ e.error }}</p>{% endif %}{% endfor %}</div>
<div><p><strong>前置：</strong>{{ attempt.preconditions }}</p><p><strong>动作：</strong>{{ attempt.action }}</p><p><strong>预期：</strong>{{ attempt.expected }}</p><p><strong>实际：</strong>{{ attempt.actual }}</p>{% if attempt.error_message %}<p class="missing">首次现场 {{ attempt.failure_class }}：{{ attempt.error_message }}</p>{% endif %}
<table class="mem-table assertions"><thead><tr><th>维度</th><th>预期 / 实际</th><th>判定</th><th>证据</th></tr></thead><tbody>{% for a in attempt.assertions %}<tr><td>{{ a.dimension }}</td><td>{{ a.expected }}<br>{{ a.actual }}</td><td>{{ a.status }}</td><td>{{ a.evidence_refs|join(', ') }}</td></tr>{% else %}<tr><td colspan="4" class="missing">未采集断言，不等同 PASS</td></tr>{% endfor %}</tbody></table>
{% for e in attempt.display_evidence %}<details><summary>{{ e.evidence_id }} · {{ e.kind }} · {{ e.status }}{% if not e.available %} · 证据缺失/校验失败{% endif %}</summary>{% if e.available %}<a href="{{ e.url }}">完整原始材料</a>{% if e.preview %}<pre>{{ e.preview }}</pre>{% endif %}{% if e.is_video %}<video controls preload="none" style="max-width:100%" src="{{ e.url }}{% if e.metadata.offset_s is defined %}#t={{ e.metadata.offset_s }}{% endif %}"></video>{% endif %}{% else %}<p class="missing">{{ e.error or e.capture_error }}</p>{% endif %}<p>采样 {{ e.capture_at }} · 来源 {{ e.source }} · 关联 {{ e.association }} / {{ e.confidence }}</p></details>{% endfor %}
<details><summary>实际工具子流水（不参与业务分母）</summary>{% for tool in attempt.tools %}<p>{{ tool.tool_call_id }} · {{ tool.action }} · {{ tool.status }} · {{ tool.detail }}{% if tool.capture_error %} · 采集错误 {{ tool.capture_error }}{% endif %}</p>{% else %}<p>未记录工具调用</p>{% endfor %}</details>
</div></div></details>{% endfor %}</article>{% endfor %}</div></div></section>
{% else %}<section class="section"><h2>业务证据未知 / 不可信</h2>{% if business_error %}<p class="missing">结构化运行包损坏或不符合契约：{{ business_error }}。停止业务验收，不退化为旧包通过。</p>{% else %}<p class="missing">此旧运行包没有声明业务步骤与证据清单。以下仅为工具流水与执行结果，不能推断完整功能验收通过。</p>{% endif %}</section>{% endif %}
<script>
(function(){const button=document.getElementById('scene-button'),out=document.getElementById('scene-result');button.addEventListener('click',async()=>{button.disabled=true;try{if(location.protocol==='file:')throw new Error('离线报告不能执行设备复原，请使用已明确启用复原的本机 dashboard');const name=document.getElementById('scene-restore').dataset.runName;const plan=await(await fetch('/api/scene-plan?name='+encodeURIComponent(name))).json();out.textContent=JSON.stringify(plan,null,2);if(!plan.enabled||plan.status!=='READY')throw new Error('计划被阻断或服务未批准此 manifest');const serial=document.getElementById('scene-serial').value.trim();if(!serial||serial!==plan.device_serial)throw new Error('必须显式填写匹配的设备 serial');if(!confirm('将在所选设备停止并重新启动已批准的离线 Demo，保持在目标状态。无法满足前置会停止。确认？'))return;const body=new URLSearchParams({name,serial,manifest_sha256:plan.manifest_sha256,token:plan.token});const job=await(await fetch('/api/restore-scene',{method:'POST',body})).json();out.textContent=JSON.stringify(job,null,2);if(!job.job_id)return;let result;do{await new Promise(resolve=>setTimeout(resolve,700));result=await(await fetch('/api/scene-result?job_id='+encodeURIComponent(job.job_id))).json();out.textContent=JSON.stringify(result,null,2);}while(result.status==='RUNNING');}catch(error){out.textContent=error.message;}finally{button.disabled=false;}});})();
</script>
