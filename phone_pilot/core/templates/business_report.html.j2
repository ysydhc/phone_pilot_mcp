<style>
.storyboard{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-top:14px}
.story-card{display:block;border:1px solid var(--border);border-radius:10px;padding:10px;background:var(--bg);text-decoration:none;color:var(--text);transition:transform .15s,box-shadow .15s}
.story-card:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(0,0,0,.08);text-decoration:none}
.story-screen{width:100%;height:260px;object-fit:contain;background:#0f172a;border-radius:6px;margin-bottom:8px}
.business-layout{display:grid;grid-template-columns:200px 1fr;gap:20px}
.business-nav{position:sticky;top:60px;align-self:start;background:var(--bg);border:1px solid var(--border);border-radius:10px;overflow:hidden}
.business-nav a{display:block;padding:10px 12px;border-bottom:1px solid var(--border);font-size:.84rem;color:var(--text)}
.business-nav a:last-child{border-bottom:none}
.business-nav a:hover{background:var(--surface);color:var(--blue);text-decoration:none}
.business-step{scroll-margin-top:70px;margin-bottom:20px;border:1px solid var(--border);border-radius:12px;padding:18px;background:var(--bg)}
.attempt-grid{display:grid;grid-template-columns:minmax(180px,300px) 1fr;gap:20px;margin-top:12px}
.full-screen{width:100%;max-height:600px;object-fit:contain;background:#0f172a;border-radius:8px;border:1px solid var(--border)}
.business-step pre{white-space:pre-wrap;word-break:break-word;max-height:280px;overflow:auto;background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:.78rem}
.assertions td{vertical-align:top;overflow-wrap:anywhere}
.assertions td:nth-child(3){white-space:nowrap}
.assertions{table-layout:auto}
.missing{color:#d97706;font-weight:500}

/* ---- v3.0 Multi-Scene Matrix (/release-gate) ---- */
.suite-matrix-section{border:2px solid var(--border);border-radius:14px;background:var(--surface);padding:20px;margin-bottom:20px}
.suite-matrix-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--border)}
.suite-filter-bar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.suite-filter-btn{padding:6px 14px;border-radius:20px;border:1px solid var(--border);background:var(--bg);color:var(--text2);font-size:.8rem;font-weight:600;cursor:pointer;transition:all .15s}
.suite-filter-btn:hover,.suite-filter-btn.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.suite-matrix-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px}
.suite-card{border:1px solid var(--border);border-radius:12px;padding:14px;background:var(--bg);display:flex;flex-direction:column;justify-content:space-between;gap:10px;transition:transform .15s,box-shadow .15s}
.suite-card:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.08)}
.suite-card.fail-card{border-color:rgba(239,68,68,.55);background:rgba(239,68,68,.04)}
.suite-card-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.suite-group-tag{font-size:.72rem;font-weight:600;padding:2px 8px;border-radius:6px;background:var(--surface);color:var(--text2);border:1px solid var(--border)}
.suite-status-pill{font-size:.74rem;font-weight:700;padding:2px 9px;border-radius:12px}
.suite-status-pill.pass{background:rgba(34,197,94,.15);color:var(--green)}
.suite-status-pill.fail{background:rgba(239,68,68,.16);color:var(--red)}
.suite-card-title{font-size:.95rem;font-weight:700;color:var(--text);line-height:1.35}
.suite-card-meta{font-size:.78rem;color:var(--text2);line-height:1.4;word-break:break-word}
.suite-thumb{width:100%;height:170px;object-fit:contain;background:#0f172a;border-radius:8px;border:1px solid var(--border);cursor:pointer}
.suite-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
.scene-act-btn{flex:1 1 auto;padding:7px 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:.78rem;font-weight:600;cursor:pointer;text-align:center;white-space:nowrap;transition:all .15s}
.scene-act-btn:hover{border-color:var(--blue);color:var(--blue)}
.scene-act-btn.primary{background:rgba(37,99,235,.12);border-color:rgba(59,130,246,.4);color:var(--blue)}
.scene-act-btn.primary:hover{background:var(--blue);color:#fff}

/* ---- Video Chapter Bar ---- */
.video-chapter-bar{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px}
.video-chapter-pill{padding:5px 11px;border-radius:16px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:.78rem;font-weight:600;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:5px}
.video-chapter-pill:hover{border-color:var(--blue);background:rgba(59,130,246,.12);color:var(--blue)}
.video-chapter-pill.fail{border-color:rgba(239,68,68,.45);color:var(--red)}

/* ---- v3.0 Bottom Collapsible Scene Restore Drawer ---- */
.restore-section-anchor{scroll-margin-top:70px;margin-top:24px;margin-bottom:20px}
.restore-drawer{border:1px solid rgba(59,130,246,.4);border-radius:14px;background:var(--surface);overflow:hidden;box-shadow:0 4px 16px rgba(37,99,235,.06);transition:all .2s}
.restore-drawer[open]{border-width:2px;box-shadow:0 10px 28px rgba(37,99,235,.12)}
.restore-drawer-summary{list-style:none;cursor:pointer;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;background:linear-gradient(90deg,rgba(37,99,235,.08) 0%,var(--surface) 100%);user-select:none}
.restore-drawer-summary::-webkit-details-marker{display:none}
.drawer-summary-left{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.drawer-icon{font-size:1.15rem}
.drawer-title{font-size:.98rem;font-weight:700;color:var(--text)}
.drawer-tag{font-size:.75rem;font-weight:600;color:var(--blue);background:rgba(59,130,246,.12);padding:2px 8px;border-radius:6px}
.drawer-summary-right{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.drawer-hint{font-size:.78rem;color:var(--text2)}
.drawer-toggle-btn{padding:6px 14px;border-radius:8px;background:var(--blue);color:#fff;font-size:.8rem;font-weight:700;display:inline-flex;align-items:center;gap:6px;transition:transform .15s}
.restore-drawer[open] .drawer-arrow{transform:rotate(180deg);display:inline-block}
.restore-console{padding:20px;border-top:1px solid var(--border);background:var(--bg);box-sizing:border-box;max-width:100%;overflow:hidden}
.restore-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.restore-title-group h2{font-size:1.12rem;font-weight:700;margin:0 0 6px 0;display:flex;align-items:center;gap:8px;color:var(--text);flex-wrap:wrap}
.restore-title-group p{margin:0;font-size:.84rem;color:var(--text2);line-height:1.5}
.restore-badge{padding:4px 11px;border-radius:20px;font-size:.76rem;font-weight:700;background:rgba(34,197,94,.14);color:var(--green);white-space:nowrap}
.restore-controls{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;background:var(--surface);padding:16px;border-radius:10px;border:1px solid var(--border);margin-bottom:18px;box-sizing:border-box;width:100%;max-width:100%}
.control-field{display:flex;flex-direction:column;gap:6px;flex:1 1 240px;min-width:0;max-width:100%;box-sizing:border-box}
.control-field.scene-field{flex:1 1 260px}
.control-field.mode-field{flex:0 1 250px}
.control-action{flex:0 0 auto;display:flex;align-items:flex-end}
.control-field label{font-size:.78rem;font-weight:600;color:var(--text2);display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.device-select-row{display:flex;gap:8px;width:100%;min-width:0;box-sizing:border-box}
.device-select{flex:1 1 auto;min-width:0;width:100%;max-width:100%;padding:9px 12px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.85rem;font-weight:500;outline:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;box-sizing:border-box}
.device-select:focus{border-color:var(--blue)}
.btn-refresh{flex:0 0 auto;padding:8px 12px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;white-space:nowrap;transition:all .15s;height:38px;box-sizing:border-box}
.btn-refresh:hover{border-color:var(--blue);color:var(--blue)}
.btn-launch-restore{padding:10px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;font-size:.9rem;font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(37,99,235,.28);transition:all .15s;white-space:nowrap;height:38px;box-sizing:border-box}
.btn-launch-restore:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 6px 16px rgba(37,99,235,.38)}
.btn-launch-restore:disabled{opacity:.6;cursor:not-allowed;transform:none}

/* ---- Interactive Stepper ---- */
.stepper-title{font-size:.82rem;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.04em;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.stepper-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;margin-bottom:16px}
.step-card-item{border:1px solid var(--border);border-radius:9px;padding:10px 12px;background:var(--surface);display:flex;gap:10px;align-items:flex-start;transition:all .2s}
.step-card-item.running{border-color:var(--blue);background:rgba(59,130,246,.08);box-shadow:0 0 0 2px rgba(59,130,246,.18)}
.step-card-item.done{border-color:rgba(34,197,94,.45);background:rgba(34,197,94,.05)}
.step-card-item.failed{border-color:rgba(239,68,68,.55);background:rgba(239,68,68,.06)}
.step-idx-dot{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;flex-shrink:0;background:var(--border);color:var(--text2);margin-top:1px}
.step-card-item.running .step-idx-dot{background:var(--blue);color:#fff;animation:pulseDot 1.2s infinite}
.step-card-item.done .step-idx-dot{background:var(--green);color:#fff}
.step-card-item.failed .step-idx-dot{background:var(--red);color:#fff}
@keyframes pulseDot{0%,100%{transform:scale(1)}50%{transform:scale(1.14)}}
.step-card-body{flex:1;min-width:0}
.step-card-title{font-size:.84rem;font-weight:600;color:var(--text);line-height:1.3;margin-bottom:3px}
.step-card-desc{font-size:.74rem;color:var(--text2);line-height:1.35;word-break:break-word}
.step-card-time{font-size:.7rem;color:var(--green);font-weight:600;margin-top:3px}

/* ---- Final Result Showcase ---- */
.restore-outcome-card{display:none;margin-top:16px;border:1px solid rgba(34,197,94,.45);background:rgba(34,197,94,.06);border-radius:12px;padding:16px}
.restore-outcome-card.failed{border-color:rgba(239,68,68,.5);background:rgba(239,68,68,.06)}
.outcome-layout{display:grid;grid-template-columns:220px 1fr;gap:18px;align-items:center}
.outcome-shot{width:100%;max-height:380px;object-fit:contain;background:#0f172a;border-radius:8px;border:1px solid var(--border);cursor:pointer}

/* ---- v4.0 Lifecycle Pill Chain & Syntax Highlighting ---- */
.lifecycle-chain{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:8px 0}
.lc-pill{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:14px;font-size:.73rem;font-weight:700;border:1px solid transparent;cursor:pointer;transition:transform .12s,box-shadow .12s;user-select:none}
.lc-pill:hover{transform:translateY(-1px);box-shadow:0 3px 8px rgba(0,0,0,.12)}
.lc-pill.pass{background:rgba(34,197,94,.14);color:var(--green);border-color:rgba(34,197,94,.35)}
.lc-pill.fail{background:rgba(239,68,68,.16);color:var(--red);border-color:rgba(239,68,68,.45)}
.lc-pill.na{background:var(--surface);color:var(--text2);border-color:var(--border);opacity:.65}
.lc-arrow{color:var(--text2);font-size:.7rem;opacity:.55;user-select:none}
.card-lc-mini{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.card-lc-dot{font-size:.68rem;font-weight:600;padding:1px 6px;border-radius:8px}
.card-lc-dot.pass{background:rgba(34,197,94,.13);color:var(--green)}
.card-lc-dot.fail{background:rgba(239,68,68,.16);color:var(--red)}
.card-lc-dot.na{background:var(--surface);color:var(--text2);opacity:.6}

/* ---- v4.0 In-Place All-in-One Scene Inspector ---- */
.quick-inspector{display:none;margin:14px 0 18px;border:2px solid var(--blue);border-radius:14px;background:var(--bg);padding:18px;box-shadow:0 10px 30px rgba(37,99,235,.14);scroll-margin-top:70px}
.quick-inspector.open{display:block}
.qi-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--border);margin-bottom:12px}
.qi-nav-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.qi-kbd{background:var(--surface);border:1px solid var(--border);border-radius:5px;padding:1px 6px;font-family:var(--mono);font-size:.72rem;color:var(--text2)}
.qi-body{display:grid;grid-template-columns:minmax(250px,330px) 1fr;gap:18px;align-items:start}
.qi-log-box{background:#0f172a;color:#e2e8f0;font-family:var(--mono);font-size:.76rem;line-height:1.65;padding:12px 14px;border-radius:10px;max-height:330px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;border:1px solid #1e293b}
.qi-log-line{padding:3px 6px;border-radius:5px;cursor:pointer;border-left:3px solid transparent;transition:background .12s,opacity .15s}
.qi-log-line:hover{background:rgba(59,130,246,.16)}
.qi-log-line.active-time{background:rgba(59,130,246,.22);border-left-color:#60a5fa}
.qi-log-line.future-time{opacity:.38}
.qi-log-ts{color:#94a3b8;font-size:.7rem;margin-right:6px;user-select:none}
.qi-media-tabs{display:inline-flex;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:2px;gap:2px}
.qi-media-tab{border:none;background:transparent;color:var(--text2);font-size:.74rem;font-weight:700;padding:4px 9px;border-radius:6px;cursor:pointer;transition:all .12s;white-space:nowrap}
.qi-media-tab.active{background:var(--blue);color:#fff}
.qi-speed-pill{border:1px solid var(--border);background:var(--surface);color:var(--text2);font-size:.68rem;font-weight:700;padding:2px 6px;border-radius:5px;cursor:pointer}
.qi-speed-pill.active{border-color:var(--blue);color:var(--blue);background:rgba(59,130,246,.12)}
.qi-thumb-strip{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;margin-top:8px;padding-bottom:4px;scrollbar-width:thin}
.qi-thumb-btn{flex:0 0 46px;width:46px;height:64px;padding:0;border:2px solid var(--border);border-radius:6px;overflow:hidden;background:#0f172a;cursor:pointer;opacity:.75;transition:opacity .12s,border-color .12s}
.qi-thumb-btn:hover,.qi-thumb-btn.active{opacity:1;border-color:var(--blue)}
.qi-thumb-btn img{width:100%;height:100%;object-fit:cover;display:block}
.card-filmstrip{display:flex;gap:8px;align-items:stretch;justify-content:center;background:linear-gradient(180deg,rgba(15,23,42,.55),rgba(15,23,42,.92));border:1px solid var(--border);border-radius:10px;padding:8px;cursor:pointer;position:relative;overflow:hidden;min-height:136px}
.card-filmstrip:hover .card-play-pill{opacity:1;transform:translateY(0)}
.card-frame{position:relative;flex:0 1 auto;border-radius:7px;overflow:hidden;border:1px solid rgba(148,163,184,.28);background:#020617;box-shadow:0 3px 10px rgba(0,0,0,.35)}
.card-frame img{display:block;height:122px;width:auto;max-width:100%;object-fit:contain}
.card-frame-cap{position:absolute;left:4px;bottom:4px;background:rgba(2,6,23,.82);color:#cbd5e1;font-size:.62rem;padding:1px 5px;border-radius:4px;font-family:var(--mono)}
.card-play-pill{position:absolute;top:6px;right:6px;background:rgba(37,99,235,.9);color:#fff;font-size:.66rem;font-weight:700;padding:2px 7px;border-radius:999px;opacity:.9;transition:opacity .15s,transform .15s;box-shadow:0 2px 8px rgba(0,0,0,.4)}
.hl-tok-success{background:rgba(16,185,129,.22);color:#6ee7b7;padding:1px 5px;border-radius:4px;font-weight:700}
.hl-tok-metric{background:rgba(245,158,11,.22);color:#fde68a;padding:1px 5px;border-radius:4px;font-weight:700}
.hl-tok-network{background:rgba(59,130,246,.24);color:#93c5fd;padding:1px 5px;border-radius:4px;font-weight:600}
.hl-tok-danger{background:rgba(239,68,68,.28);color:#fca5a5;padding:1px 5px;border-radius:4px;font-weight:700}

/* ---- v4.0 Screenshot Tap Bullseye Overlay ---- */
.shot-annot-wrap{position:relative;display:inline-block;width:100%;background:#0f172a;border-radius:8px;overflow:hidden;border:1px solid var(--border)}
.shot-annot-wrap img{display:block;width:100%;max-height:340px;object-fit:contain;margin:0 auto}
.tap-bullseye{position:absolute;width:28px;height:28px;margin-left:-14px;margin-top:-14px;border-radius:50%;background:rgba(239,68,68,.38);border:2px solid #ef4444;box-shadow:0 0 0 4px rgba(239,68,68,.2),0 2px 8px rgba(0,0,0,.5);pointer-events:none;display:flex;align-items:center;justify-content:center;animation:pulseBullseye 1.5s infinite}
.tap-bullseye::after{content:'';width:6px;height:6px;border-radius:50%;background:#fff}
.tap-bullseye-tag{position:absolute;transform:translate(-50%,-135%);background:rgba(15,23,42,.92);color:#fca5a5;border:1px solid #ef4444;border-radius:6px;padding:2px 7px;font-size:.68rem;font-weight:700;white-space:nowrap;pointer-events:none;box-shadow:0 2px 6px rgba(0,0,0,.4)}
@keyframes pulseBullseye{0%,100%{transform:scale(1)}50%{transform:scale(1.18)}}
.suite-card.active-inspect{border-color:var(--blue);box-shadow:0 0 0 2px rgba(59,130,246,.28)}

@media(max-width:760px){
  .business-layout,.attempt-grid,.outcome-layout,.qi-body{grid-template-columns:1fr}
  .business-nav{position:static}
  .storyboard{grid-template-columns:repeat(2,minmax(0,1fr))}
  .drawer-hint{display:none}
}
</style>

<!-- 全局业务生命周期可视化灯带 (0.5秒一眼确认全链路节点状态) -->
{% if global_lifecycle_pills and not (scene and scene.is_multi_suite and scene.scenes) %}
<div class="section" style="padding:14px 18px;margin-bottom:16px;border-left:4px solid {{ 'var(--green)' if scene.catalog and scene.catalog.gate_pass else 'var(--blue)' }};">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <span style="font-size:.88rem;font-weight:700;color:var(--text);">🧬 核心生命周期全链路灯带</span>
      <span style="font-size:.74rem;color:var(--text2);background:var(--bg);padding:2px 8px;border-radius:6px;border:1px solid var(--border);">
        {{ acceptance_profile.profile_name if acceptance_profile else '通用移动应用验收视图' }} · 点击任意节点可定位下方日志
      </span>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <button type="button" class="btn-sm" onclick="if(window.copyMarkdownSummary)window.copyMarkdownSummary()" style="background:rgba(37,99,235,.12);color:var(--blue);border-color:rgba(59,130,246,.4);font-weight:700;">
        📋 一键复制验收结论 (贴 iCafe / IM)
      </button>
    </div>
  </div>
  <div class="lifecycle-chain" style="margin-top:10px;margin-bottom:2px;">
    {% for pill in global_lifecycle_pills %}
      <span class="lc-pill {{ pill.status|lower }}" title="{{ pill.evidence }}" data-label="{{ pill.label }}" data-evidence="{{ pill.evidence }}" onclick="if(window.jumpToLogKeyword)window.jumpToLogKeyword(this.dataset.label, this.dataset.evidence)">
        <span>{{ '🟢' if pill.status == 'PASS' else ('🔴' if pill.status == 'FAIL' else '⚪') }}</span>
        <span>{{ pill.label }}</span>
      </span>
      {% if not loop.last %}<span class="lc-arrow">&rarr;</span>{% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

{% if scene.is_multi_suite and scene.scenes %}
<!-- 多场景门禁矩阵看板 (/release-gate 等聚合套件脚本) -->
<section class="suite-matrix-section" id="suite-matrix">
  <div class="suite-matrix-header">
    <div>
      <h2 style="margin:0 0 4px 0;font-size:1.15rem;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <span>🚦 多场景门禁验收矩阵 ({{ scene.scenes|length }} 个独立子场景)</span>
        <span style="font-size:.82rem;padding:3px 10px;border-radius:12px;background:{{ 'rgba(34,197,94,.15)' if scene.catalog.gate_pass else 'rgba(239,68,68,.15)' }};color:{{ 'var(--green)' if scene.catalog.gate_pass else 'var(--red)' }};">
          {{ 'GO ✅ 全部套件通过' if scene.catalog.gate_pass else 'NO-GO ⚠️ 存在 ' ~ scene.catalog.failed_scenes ~ ' 个待排查场景' }}
        </span>
      </h2>
      <div style="font-size:.82rem;color:var(--text2);">
        通过场景 <b style="color:var(--green);">{{ scene.catalog.passed_scenes }}</b> / {{ scene.catalog.total_scenes }} ·
        点击任意卡片可<strong>就地展开「三证合一」极速审片台（支持键盘 <kbd class="qi-kbd">&larr;</kbd> <kbd class="qi-kbd">&rarr;</kbd> 1秒切换场景）</strong>，无需上下滚屏。
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button type="button" id="qi-toggle-mode-btn" class="scene-act-btn primary" onclick="if(window.toggleQuickInspectorMode)window.toggleQuickInspectorMode()">
        ⚡ 开启键盘极速审片模式 (&larr; / &rarr;)
      </button>
    </div>
  </div>

  <!-- 套件分类筛选胶囊 -->
  <div class="suite-filter-bar" id="suite-filter-bar">
    <button type="button" class="suite-filter-btn active" data-filter="all">全部场景 ({{ scene.scenes|length }})</button>
    {% if scene.catalog.failed_scenes > 0 %}
    <button type="button" class="suite-filter-btn" data-filter="fail" style="color:var(--red);">❌ 仅看失败 ({{ scene.catalog.failed_scenes }})</button>
    {% endif %}
    {% set seen_groups = [] %}
    {% for sc in scene.scenes %}
      {% if sc.group not in seen_groups %}
        {% set _ = seen_groups.append(sc.group) %}
        <button type="button" class="suite-filter-btn" data-filter="group-{{ sc.group }}">{{ sc.group_label }}</button>
      {% endif %}
    {% endfor %}
  </div>

  <!-- v4.0 就地展开「三证合一」极速审片工作台 (In-Place All-in-One Scene Inspector) -->
  <div class="quick-inspector" id="scene-quick-inspector">
    <div class="qi-header">
      <div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <span id="qi-badge" class="suite-status-pill pass">✔ PASS</span>
          <strong id="qi-title" style="font-size:1.05rem;color:var(--text);">场景详情</strong>
          <span id="qi-meta" style="font-size:.8rem;color:var(--text2);"></span>
        </div>
      </div>
      <div class="qi-nav-group">
        <span id="qi-progress" style="font-size:.78rem;color:var(--text2);margin-right:4px;">1 / {{ scene.scenes|length }}</span>
        <button type="button" class="btn-sm" id="qi-share-link-btn" title="复制直达当前场景的深链 URL (#scene=...)" style="border-color:var(--blue);color:var(--blue);">🔗 场景直达链接</button>
        <button type="button" class="btn-sm" id="qi-prev-btn" title="快捷键：键盘左方向键 ← 或 K">&larr; 上一场景 (<span class="qi-kbd">&larr;</span>)</button>
        <button type="button" class="btn-sm" id="qi-next-btn" title="快捷键：键盘右方向键 → 或 J">下一场景 (<span class="qi-kbd">&rarr;</span>) &rarr;</button>
        <button type="button" class="btn-sm" id="qi-close-btn" title="快捷键：Esc">✖ 收起</button>
      </div>
    </div>

    <!-- 当前场景专属生命周期灯带 -->
    <div id="qi-pills-row" class="lifecycle-chain" style="margin-bottom:12px;"></div>

    <div class="qi-body">
      <!-- 左栏：单屏切换式视觉工作台（实机录屏 Tab / 关键帧靶心截图 Tab + 横向胶片条 + 倍速控制） -->
      <div style="min-width:0;">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
          <div class="qi-media-tabs">
            <button type="button" class="qi-media-tab active" id="qi-tab-video">🎬 实机录屏</button>
            <button type="button" class="qi-media-tab" id="qi-tab-shot">🖼️ 关键帧</button>
          </div>
          <div style="display:flex;align-items:center;gap:4px;">
            <span id="qi-speed-group" style="display:inline-flex;gap:3px;">
              <button type="button" class="qi-speed-pill active" data-rate="1">1x</button>
              <button type="button" class="qi-speed-pill" data-rate="1.5">1.5x</button>
              <button type="button" class="qi-speed-pill" data-rate="2">2x</button>
            </span>
            <button type="button" class="qi-speed-pill" id="qi-zoom-btn" title="全屏放大查看关键帧">🔍 放大</button>
          </div>
        </div>
        <video id="qi-video" controls playsinline preload="metadata" style="width:100%;height:340px;object-fit:contain;border-radius:8px;background:#000;display:none;border:1px solid var(--border);"></video>
        <div class="shot-annot-wrap" id="qi-shot-wrap" style="display:none;">
          <img id="qi-shot-img" alt="场景截图" style="height:340px;max-height:340px;cursor:zoom-in;">
          <div id="qi-tap-bullseye" class="tap-bullseye" style="display:none;"></div>
          <div id="qi-tap-tag" class="tap-bullseye-tag" style="display:none;"></div>
        </div>
        <div id="qi-thumb-strip" class="qi-thumb-strip" style="display:none;"></div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;">
          <button type="button" class="scene-act-btn" id="qi-video-start-btn" style="display:none;">🎬 播起点</button>
          <button type="button" class="scene-act-btn" id="qi-video-hl-btn" style="display:none;border-color:rgba(245,158,11,.5);color:var(--amber);">⚡ 跳高光</button>
          <button type="button" class="scene-act-btn primary" id="qi-restore-btn">📱 复现此场景 (R)</button>
        </div>
      </div>

      <!-- 右栏：VLM 结论 + 业务断言 + 子用例明细矩阵 + 随视频时间联动日志 -->
      <div style="min-width:0;">
        <div id="qi-vlm-box" style="display:none;margin-bottom:8px;padding:8px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface);font-size:.8rem;"></div>
        <div id="qi-assertions-box" style="display:none;margin-bottom:8px;flex-wrap:wrap;gap:6px;"></div>
        <div id="qi-subcases-box" style="display:none;margin-bottom:8px;padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--surface);"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:6px;">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="font-size:.82rem;font-weight:700;color:var(--text);">🎯 本场景专属日志 &amp; 业务断言</span>
            <span id="qi-video-time-badge" style="font-size:.72rem;color:var(--blue);font-family:var(--mono);display:none;">00:00.0</span>
          </div>
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
            <button type="button" class="btn-sm" id="qi-log-sync-btn" style="display:none;border-color:var(--blue);color:var(--blue);">⏱️ 随视频时间同步</button>
            <button type="button" class="btn-sm" id="qi-copy-logs-btn">📋 复制本场景日志</button>
          </div>
        </div>
        <div class="qi-log-box" id="qi-log-box"></div>

        <div style="margin-top:10px;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:8px;font-size:.78rem;color:var(--text2);">
          <div style="font-weight:700;color:var(--text);margin-bottom:4px;">🛠️ 真机复原动作配方链：</div>
          <div id="qi-recipe-chain" style="line-height:1.5;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 场景卡片矩阵 -->
  <div class="suite-matrix-grid" id="suite-matrix-grid">
    {% for sc in scene.scenes %}
    <div class="suite-card {{ 'fail-card' if sc.status != 'PASS' else '' }}" data-scene-idx="{{ loop.index0 }}" data-scene-id="{{ sc.scene_id }}" data-status="{{ sc.status|lower }}" data-group="group-{{ sc.group }}">
      <div>
        <div class="suite-card-top">
          <span class="suite-group-tag">#{{ sc.index }} · {{ sc.group_label }}</span>
          <span class="suite-status-pill {{ 'pass' if sc.status == 'PASS' else 'fail' }}">{{ '✔ PASS' if sc.status == 'PASS' else '✖ FAIL' }}</span>
        </div>
        <div class="suite-card-title" style="margin-top:8px;cursor:pointer;" onclick="if(window.openQuickInspector)window.openQuickInspector({{ loop.index0 }})">{{ sc.title }}</div>
        <div class="suite-card-meta" style="margin-top:4px;">{{ sc.detail }} · 耗时 {{ sc.elapsed_s }}s</div>

        {% if sc.lifecycle_pills %}
        <div class="card-lc-mini">
          {% for p in sc.lifecycle_pills[:5] %}
          <span class="card-lc-dot {{ p.status|lower }}" title="{{ p.evidence|e }}">
            {{ '●' if p.status == 'PASS' else ('✖' if p.status == 'FAIL' else '○') }} {{ p.label.split(' ')[-1] }}
          </span>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      {% set card_shots = sc.screenshots if (sc.screenshots and sc.screenshots|length) else ([sc.screenshot] if sc.screenshot else []) %}
      {% set card_has_video = sc.video_rel_path or sc.global_video_rel_path or (recordings and recordings|length > 0) %}
      {% if card_shots %}
      <div class="card-filmstrip" onclick="if(window.openQuickInspector)window.openQuickInspector({{ loop.index0 }}, {{ 'true' if card_has_video else 'false' }})" title="点击展开审片台并{{ '播放录屏' if card_has_video else '查看关键帧' }}">
        {% for s_item in card_shots[:3] %}
        {% set frame_src = s_item if (s_item.startswith('screenshots/') or s_item.startswith('scenes/') or s_item.startswith('evidence/') or s_item.startswith('recordings/') or s_item.startswith('http') or s_item.startswith('/')) else 'screenshots/' ~ s_item %}
        <div class="card-frame">
          <img src="{{ frame_src }}" alt="{{ sc.title }} #{{ loop.index }}">
          <span class="card-frame-cap">{{ '终态' if loop.last else '帧#' ~ loop.index }}</span>
          {% if loop.last and sc.tap_annotation and sc.tap_annotation.has_coords %}
          <div class="tap-bullseye" style="left:{{ sc.tap_annotation.tap_x_pct }}%;top:{{ sc.tap_annotation.tap_y_pct }}%;"></div>
          {% endif %}
        </div>
        {% endfor %}
        {% if card_has_video %}
        <span class="card-play-pill">▶ 播录屏</span>
        {% endif %}
      </div>
      {% endif %}

      <div class="suite-actions">
        <button type="button" class="scene-act-btn" onclick="if(window.openQuickInspector)window.openQuickInspector({{ loop.index0 }}, false)" title="原地展开本场景录屏、截图、断言与联动日志">
          🔍 极速审片
        </button>
        {% if card_has_video %}
        <button type="button" class="scene-act-btn" onclick="if(window.openQuickInspector)window.openQuickInspector({{ loop.index0 }}, true)" title="直接播放本场景实机录屏并同步日志">
          🎬 {{ '播录屏' if sc.video_rel_path else ('播片段 ' ~ sc.video_time_label) }}
        </button>
        {% endif %}
        <button type="button" class="scene-act-btn primary" data-scene-id="{{ sc.scene_id }}" onclick="if(window.openRestoreForScene)window.openRestoreForScene(this.dataset.sceneId)">
          📱 复现
        </button>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<script id="acceptance-profile-json" type="application/json">{{ (acceptance_profile or {})|tojson }}</script>
<script id="markdown-summary-json" type="application/json">{{ (markdown_summary or '')|tojson }}</script>

<script>
(function(){
  // 1. Universal Syntax Highlighter driven by AcceptanceProfile
  let profileData = {};
  try {
    const rawProf = document.getElementById('acceptance-profile-json');
    if (rawProf && rawProf.textContent) profileData = JSON.parse(rawProf.textContent) || {};
  } catch (e) {}

  const hlConfig = (profileData.log_filter && profileData.log_filter.highlights) || {
    success: ['[PASS]', '✔ PASS', 'SUCCESS', 'ASSERT_OK', 'VERIFY_OK'],
    metric: ['duration=', 'elapsed=', 'latency=', 'cost:', 'status=200'],
    network: ['MockServer', 'HTTP', 'am broadcast', 'reverse tcp:'],
    danger: ['FAIL', 'FAILED', 'ERROR', 'FATAL EXCEPTION', 'ANR in']
  };

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
  window.escapeHtml = escapeHtml;

  function escapeRegex(s) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  const _hlTokenMap = new Map();
  [
    { cls: 'hl-tok-danger', tokens: hlConfig.danger || [] },
    { cls: 'hl-tok-metric', tokens: hlConfig.metric || [] },
    { cls: 'hl-tok-network', tokens: hlConfig.network || [] },
    { cls: 'hl-tok-success', tokens: hlConfig.success || [] }
  ].forEach(group => {
    (group.tokens || []).forEach(tok => {
      if (!tok || tok.length < 2) return;
      const esc = escapeHtml(tok);
      if (!_hlTokenMap.has(esc)) _hlTokenMap.set(esc, group.cls);
    });
  });
  const _hlSortedTokens = Array.from(_hlTokenMap.keys()).sort((a, b) => b.length - a.length);
  const _hlMasterRegex = _hlSortedTokens.length
    ? new RegExp('(' + _hlSortedTokens.map(escapeRegex).join('|') + ')', 'g')
    : null;

  function compactLongQuery(str) {
    return String(str || '').replace(/([?&](?:code|data|payload)=)[A-Za-z0-9+/=%_-]{48,}/g, '$1<encrypted…>');
  }

  window.highlightLogHtml = function(rawText) {
    const html = escapeHtml(compactLongQuery(rawText));
    if (!_hlMasterRegex) return html;
    return html.replace(_hlMasterRegex, (m) => `<span class="${_hlTokenMap.get(m) || 'hl-tok-success'}">${m}</span>`);
  };

  // Apply syntax highlighting to #key-acceptance-log-preview on page load
  window.addEventListener('DOMContentLoaded', () => {
    const mainLogBox = document.getElementById('key-acceptance-log-preview');
    if (mainLogBox && mainLogBox.textContent) {
      mainLogBox.innerHTML = window.highlightLogHtml(mainLogBox.textContent);
    }
  });

  // 2. One-click copy Markdown report summary for iCafe / PR / IM
  window.copyMarkdownSummary = function() {
    let md = '';
    try {
      const el = document.getElementById('markdown-summary-json');
      if (el && el.textContent) md = JSON.parse(el.textContent) || '';
    } catch (e) {}
    if (!md) {
      md = `[PhonePilot 验收报告] ${document.title}`;
    }
    if (window.copyToClipboard) {
      window.copyToClipboard(md);
      if (window.showToast) window.showToast('📋 已复制 Markdown 验收结论，可直接粘贴至 iCafe 卡片 / CR / 如流！');
    }
  };

  // 3. Click lifecycle pill -> scroll to & filter key logs
  window.jumpToLogKeyword = function(label, evidence) {
    const logsSec = document.getElementById('logs');
    const filterInput = document.getElementById('key-log-filter');
    if (logsSec) {
      logsSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    if (filterInput && window.filterKeyAcceptanceLogs) {
      let q = '';
      const evStr = String(evidence || '');
      for (const tok of _hlSortedTokens) {
        if (tok && evStr.includes(tok)) { q = tok; break; }
      }
      filterInput.value = q;
      window.filterKeyAcceptanceLogs(q);
    }
  };

  // 4. Multi-Scene Filter & In-Place All-in-One Quick Inspector
  const bar = document.getElementById('suite-filter-bar');
  const grid = document.getElementById('suite-matrix-grid');
  const inspector = document.getElementById('scene-quick-inspector');
  if (!grid) return;

  let scenesList = [];
  function getScenesList() {
    if (scenesList.length) return scenesList;
    try {
      const rawCat = document.getElementById('scene-catalog-json');
      if (rawCat && rawCat.textContent) scenesList = JSON.parse(rawCat.textContent) || [];
    } catch (e) {}
    return scenesList;
  }

  let currentIdx = 0;
  let activeFilter = 'all';

  function getVisibleSceneIndices() {
    const list = getScenesList();
    if (!list.length) return [];
    if (activeFilter === 'all') return list.map((_, i) => i);
    if (activeFilter === 'fail') {
      return list.map((s, i) => (String(s.status).toUpperCase() !== 'PASS' ? i : -1)).filter(i => i >= 0);
    }
    if (activeFilter.startsWith('group-')) {
      const g = activeFilter.slice(6);
      return list.map((s, i) => (s.group === g ? i : -1)).filter(i => i >= 0);
    }
    return list.map((_, i) => i);
  }

  function stepQuickInspector(delta) {
    const vis = getVisibleSceneIndices();
    if (!vis.length) return;
    const pos = vis.indexOf(currentIdx);
    const nextPos = pos >= 0 ? (pos + delta + vis.length) % vis.length : 0;
    window.openQuickInspector(vis[nextPos], false);
  }

  if (bar) {
    bar.querySelectorAll('.suite-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        bar.querySelectorAll('.suite-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const f = btn.dataset.filter || 'all';
        activeFilter = f;
        grid.querySelectorAll('.suite-card').forEach(card => {
          if (f === 'all') card.style.display = '';
          else if (f === 'fail') card.style.display = (card.dataset.status !== 'pass') ? '' : 'none';
          else card.style.display = (card.dataset.group === f) ? '' : 'none';
        });
        if (inspector && inspector.classList.contains('open')) {
          const vis = getVisibleSceneIndices();
          if (!vis.length) window.closeQuickInspector();
          else if (vis.indexOf(currentIdx) === -1) window.openQuickInspector(vis[0], false);
          else window.openQuickInspector(currentIdx, false);
        }
      });
    });
  }

  function syncToggleModeBtn() {
    const tBtn = document.getElementById('qi-toggle-mode-btn');
    if (!tBtn || !inspector) return;
    const isOpen = inspector.classList.contains('open');
    tBtn.textContent = isOpen ? '✖ 关闭键盘极速审片模式 (Esc)' : '⚡ 开启键盘极速审片模式 (← / →)';
    tBtn.classList.toggle('primary', !isOpen);
  }

  window.closeQuickInspector = function() {
    if (!inspector) return;
    const qv = document.getElementById('qi-video');
    if (qv) qv.pause();
    inspector.classList.remove('open');
    grid.querySelectorAll('.suite-card').forEach(c => c.classList.remove('active-inspect'));
    syncToggleModeBtn();
  };

  window.toggleQuickInspectorMode = function() {
    if (!inspector) return;
    if (inspector.classList.contains('open')) {
      window.closeQuickInspector();
    } else {
      window.openQuickInspector(currentIdx || 0, false);
    }
  };

  window.openQuickInspector = function(idx, autoPlayVideo) {
    const list = getScenesList();
    if (!inspector || !list.length) return;
    currentIdx = (idx + list.length) % list.length;
    const sc = list[currentIdx];
    if (!sc) return;

    inspector.classList.add('open');
    syncToggleModeBtn();

    // Highlight active card
    grid.querySelectorAll('.suite-card').forEach(c => {
      c.classList.toggle('active-inspect', Number(c.dataset.sceneIdx) === currentIdx);
    });

    const badge = document.getElementById('qi-badge');
    const titleEl = document.getElementById('qi-title');
    const metaEl = document.getElementById('qi-meta');
    const progEl = document.getElementById('qi-progress');
    const pillsRow = document.getElementById('qi-pills-row');
    const qiVideo = document.getElementById('qi-video');
    const thumbStrip = document.getElementById('qi-thumb-strip');
    const shotWrap = document.getElementById('qi-shot-wrap');
    const shotImg = document.getElementById('qi-shot-img');
    const bullseye = document.getElementById('qi-tap-bullseye');
    const tapTag = document.getElementById('qi-tap-tag');
    const logBox = document.getElementById('qi-log-box');
    const logSyncBtn = document.getElementById('qi-log-sync-btn');
    const vidTimeBadge = document.getElementById('qi-video-time-badge');
    const recipeChain = document.getElementById('qi-recipe-chain');
    const vidStartBtn = document.getElementById('qi-video-start-btn');
    const vidHlBtn = document.getElementById('qi-video-hl-btn');
    const restoreBtn = document.getElementById('qi-restore-btn');
    const copyLogsBtn = document.getElementById('qi-copy-logs-btn');

    function resolveMediaPath(p) {
      if (!p) return '';
      if (p.startsWith('screenshots/') || p.startsWith('scenes/') || p.startsWith('evidence/') || p.startsWith('recordings/') || p.startsWith('http') || p.startsWith('/')) {
        return p;
      }
      return 'screenshots/' + p;
    }
    function fmtTime(sec) {
      const s = Math.max(0, Number(sec || 0));
      const m = Math.floor(s / 60);
      const rem = (s % 60).toFixed(1).padStart(4, '0');
      return `${String(m).padStart(2, '0')}:${rem}`;
    }

    if (badge) {
      const isPass = sc.status === 'PASS';
      badge.className = 'suite-status-pill ' + (isPass ? 'pass' : 'fail');
      badge.textContent = isPass ? '✔ PASS' : '✖ FAIL';
    }
    if (titleEl) titleEl.textContent = `#${sc.index} [${sc.group_label || '场景'}] ${sc.title}`;
    if (metaEl) metaEl.textContent = `${sc.detail ? sc.detail + ' · ' : ''}耗时 ${sc.elapsed_s || 0}s`;
    if (progEl) {
      const vis = getVisibleSceneIndices();
      const visPos = vis.indexOf(currentIdx);
      progEl.textContent = (activeFilter !== 'all' && visPos >= 0)
        ? `筛选 ${visPos + 1} / ${vis.length} (总 #${sc.index})`
        : `场景 ${currentIdx + 1} / ${list.length}`;
    }

    // Render per-scenario VLM verdict & human-readable assertions
    const vlmBox = document.getElementById('qi-vlm-box');
    const asrtBox = document.getElementById('qi-assertions-box');
    if (vlmBox) {
      if (sc.vlm_verdict || sc.vlm_reason) {
        const vPass = (sc.vlm_verdict || '').toUpperCase() === 'PASS';
        vlmBox.style.display = 'block';
        vlmBox.style.borderColor = vPass ? 'rgba(34,197,94,.45)' : 'rgba(239,68,68,.5)';
        vlmBox.innerHTML = `<span style="font-weight:700;color:${vPass ? 'var(--green)' : 'var(--red)'};">🤖 AI 视觉 (${escapeHtml(sc.vlm_verdict || 'INFO')}):</span> ${escapeHtml(sc.vlm_reason || '')}`;
      } else {
        vlmBox.style.display = 'none';
      }
    }
    if (asrtBox) {
      const asrts = sc.assertions || [];
      if (asrts.length) {
        asrtBox.style.display = 'flex';
        asrtBox.innerHTML = asrts.map(a => {
          const ok = (a.status || '').toUpperCase() === 'PASS';
          return `<span style="font-size:.74rem;padding:3px 8px;border-radius:6px;border:1px solid ${ok ? 'rgba(34,197,94,.4)' : 'rgba(239,68,68,.55)'};background:${ok ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.15)'};color:${ok ? 'var(--green)' : 'var(--red)'};" title="预期: ${escapeHtml(a.expected || '')}"><b>${escapeHtml(a.dim)}</b>: ${escapeHtml(a.actual || a.status)}</span>`;
        }).join('');
      } else {
        asrtBox.innerHTML = '';
        asrtBox.style.display = 'none';
      }
    }
    const subBox = document.getElementById('qi-subcases-box');
    if (subBox) {
      const subs = sc.sub_cases || [];
      if (subs.length) {
        const passCnt = subs.filter(item => (item.status || '').toUpperCase() === 'PASS').length;
        subBox.style.display = 'block';
        const badgesHtml = subs.map(item => {
          const ok = (item.status || '').toUpperCase() === 'PASS';
          return `<span class="qi-subcase-pill" style="display:inline-flex;align-items:center;gap:4px;font-size:.71rem;padding:2px 7px;border-radius:5px;border:1px solid ${ok ? 'rgba(34,197,94,.35)' : 'rgba(239,68,68,.55)'};background:${ok ? 'rgba(34,197,94,.09)' : 'rgba(239,68,68,.15)'};color:${ok ? 'var(--green)' : 'var(--red)'};" title="${escapeHtml(item.detail || item.status)}">${ok ? '✔' : '✖'} <span>${escapeHtml(item.name)}</span></span>`;
        }).join('');
        subBox.innerHTML = `<div style="font-size:.74rem;font-weight:700;color:var(--text2);margin-bottom:6px;">🧩 子用例明细矩阵 (${passCnt}/${subs.length} 通过)</div><div style="display:flex;flex-wrap:wrap;gap:5px;max-height:92px;overflow-y:auto;">${badgesHtml}</div>`;
      } else {
        subBox.innerHTML = '';
        subBox.style.display = 'none';
      }
    }

    // Render lifecycle pills
    if (pillsRow) {
      const pills = sc.lifecycle_pills || [];
      pillsRow.innerHTML = pills.map((p, i) => {
        const st = (p.status || 'NA').toLowerCase();
        const icon = p.status === 'PASS' ? '🟢' : (p.status === 'FAIL' ? '🔴' : '⚪');
        const arrow = i < pills.length - 1 ? '<span class="lc-arrow">&rarr;</span>' : '';
        return `<span class="lc-pill ${st}" title="${escapeHtml(p.evidence)}">${icon} <span>${escapeHtml(p.label)}</span></span>${arrow}`;
      }).join('');
    }

    // Render per-scenario video (supports dedicated scenes/<id>/video.mp4 OR global recording virtual chapter clip)
    const fallbackGlobalVid = (function() {
      const mainVid = document.getElementById('main-recording-video');
      return mainVid ? mainVid.getAttribute('src') : '';
    })();
    const effectiveVidSrc = sc.video_rel_path
      ? resolveMediaPath(sc.video_rel_path)
      : (sc.global_video_rel_path ? resolveMediaPath(sc.global_video_rel_path) : fallbackGlobalVid);
    const isClipMode = !sc.video_rel_path && Boolean(effectiveVidSrc);
    const baseOffset = isClipMode ? Math.max(0, Number(sc.video_offset_s || 0)) : 0;
    const clipEndSec = isClipMode
      ? Math.max(baseOffset + 1, Number(sc.video_end_s || (baseOffset + Number(sc.elapsed_s || 15))))
      : 0;
    const hasVideo = Boolean(effectiveVidSrc);

    const tabVidBtn = document.getElementById('qi-tab-video');
    const tabShotBtn = document.getElementById('qi-tab-shot');
    const speedGroup = document.getElementById('qi-speed-group');
    const zoomBtn = document.getElementById('qi-zoom-btn');

    const allShots = (sc.screenshots && sc.screenshots.length)
      ? sc.screenshots
      : (sc.screenshot ? [sc.screenshot] : []);
    const resolvedShots = allShots.map(resolveMediaPath).filter(Boolean);
    let activeShotIdx = Math.max(0, resolvedShots.length - 1);

    function setMediaTab(mode) {
      const showVid = (mode === 'video' && hasVideo) || (!resolvedShots.length && hasVideo);
      if (qiVideo) qiVideo.style.display = showVid ? 'block' : 'none';
      if (shotWrap) shotWrap.style.display = (!showVid && resolvedShots.length) ? 'block' : 'none';
      if (tabVidBtn) {
        tabVidBtn.style.display = hasVideo ? '' : 'none';
        tabVidBtn.classList.toggle('active', showVid);
      }
      if (tabShotBtn) {
        tabShotBtn.style.display = resolvedShots.length ? '' : 'none';
        tabShotBtn.textContent = `🖼️ 关键帧 (${resolvedShots.length})`;
        tabShotBtn.classList.toggle('active', !showVid && resolvedShots.length > 0);
      }
      if (speedGroup) speedGroup.style.display = showVid ? 'inline-flex' : 'none';
      if (zoomBtn) zoomBtn.style.display = resolvedShots.length ? '' : 'none';
      if (!showVid && qiVideo && !qiVideo.paused) qiVideo.pause();
    }

    function seekQiVideo(absSec, playNow) {
      if (!qiVideo || !hasVideo) return;
      setMediaTab('video');
      const target = Math.max(0, Number(absSec || 0));
      const applySeek = () => {
        try {
          qiVideo.currentTime = target;
          if (playNow) qiVideo.play().catch(() => {});
        } catch (_) {}
      };
      if (qiVideo.readyState >= 1) {
        applySeek();
      } else {
        qiVideo.addEventListener('loadedmetadata', applySeek, { once: true });
      }
    }

    if (qiVideo) {
      qiVideo.ontimeupdate = null;
      qiVideo.onseeked = null;
      if (hasVideo) {
        const prevSrc = qiVideo.getAttribute('data-active-src') || '';
        if (prevSrc !== effectiveVidSrc) {
          qiVideo.src = effectiveVidSrc;
          qiVideo.setAttribute('data-active-src', effectiveVidSrc);
          qiVideo.load();
        }
        const activeSpeedBtn = speedGroup ? speedGroup.querySelector('.qi-speed-pill.active') : null;
        if (activeSpeedBtn) qiVideo.playbackRate = Number(activeSpeedBtn.dataset.rate || 1) || 1;
        seekQiVideo(baseOffset, Boolean(autoPlayVideo));
      } else {
        qiVideo.pause();
        qiVideo.removeAttribute('src');
        qiVideo.removeAttribute('data-active-src');
        qiVideo.style.display = 'none';
      }
    }

    if (speedGroup) {
      speedGroup.querySelectorAll('.qi-speed-pill').forEach(btn => {
        btn.onclick = () => {
          const r = Number(btn.dataset.rate || 1) || 1;
          if (qiVideo) qiVideo.playbackRate = r;
          speedGroup.querySelectorAll('.qi-speed-pill').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        };
      });
    }

    // Render screenshot(s) + single-row horizontal thumb strip + tap bullseye (shown only on matching final frame)
    function syncShotBullseye() {
      const annot = sc.tap_annotation;
      const isAnnotatedFrame = (activeShotIdx === resolvedShots.length - 1);
      if (bullseye && tapTag && isAnnotatedFrame && annot && annot.has_coords) {
        bullseye.style.display = 'flex';
        bullseye.style.left = annot.tap_x_pct + '%';
        bullseye.style.top = annot.tap_y_pct + '%';
        tapTag.style.display = 'block';
        tapTag.style.left = annot.tap_x_pct + '%';
        tapTag.style.top = annot.tap_y_pct + '%';
        tapTag.textContent = annot.label || `🎯 (${annot.tap_x}, ${annot.tap_y})`;
      } else {
        if (bullseye) bullseye.style.display = 'none';
        if (tapTag) tapTag.style.display = 'none';
      }
    }
    if (shotImg && shotWrap) {
      if (resolvedShots.length) {
        shotImg.src = resolvedShots[activeShotIdx];
        shotImg.onclick = () => {
          if (window.openLightbox) window.openLightbox(activeShotIdx, resolvedShots);
        };
        syncShotBullseye();
      } else {
        shotImg.removeAttribute('src');
        shotWrap.style.display = 'none';
        if (bullseye) bullseye.style.display = 'none';
        if (tapTag) tapTag.style.display = 'none';
      }
    }
    if (zoomBtn) {
      zoomBtn.onclick = () => {
        if (resolvedShots.length && window.openLightbox) {
          window.openLightbox(activeShotIdx, resolvedShots);
        }
      };
    }
    if (tabVidBtn) tabVidBtn.onclick = () => setMediaTab('video');
    if (tabShotBtn) tabShotBtn.onclick = () => setMediaTab('shot');

    if (thumbStrip) {
      if (resolvedShots.length > 1) {
        thumbStrip.style.display = 'flex';
        thumbStrip.innerHTML = resolvedShots.map((url, sIdx) => {
          const isLast = sIdx === activeShotIdx;
          return `<button type="button" class="qi-thumb-btn ${isLast ? 'active' : ''}" data-shot-idx="${sIdx}" data-shot-url="${escapeHtml(url)}" title="点击查看关键帧 #${sIdx + 1}"><img src="${escapeHtml(url)}" alt="shot ${sIdx + 1}"></button>`;
        }).join('');
        thumbStrip.querySelectorAll('.qi-thumb-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            activeShotIdx = Number(btn.dataset.shotIdx || 0);
            if (shotImg) shotImg.src = btn.dataset.shotUrl || '';
            thumbStrip.querySelectorAll('.qi-thumb-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            syncShotBullseye();
            setMediaTab('shot');
          });
        });
      } else {
        thumbStrip.style.display = 'none';
        thumbStrip.innerHTML = '';
      }
    }

    setMediaTab(hasVideo ? 'video' : 'shot');

    // Render scene-specific timeline logs + Video <-> Log time sync
    const tlLogs = (sc.timeline_logs && sc.timeline_logs.length)
      ? sc.timeline_logs
      : ((sc.scene_logs && sc.scene_logs.length)
          ? sc.scene_logs.map((ln, i) => ({ t: Number((i * 0.5).toFixed(2)), line: ln }))
          : [{ t: 0, line: `[✔ ${sc.status}] 场景「${sc.title}」执行完成 (${sc.detail || ''})` }]);
    const rawLogs = tlLogs.map(item => `[${fmtTime(item.t)}] ${item.line}`).join('\n');
    let syncWithVideo = hasVideo;

    function getRelativeVideoTime() {
      if (!qiVideo || !hasVideo) return 0;
      return Math.max(0, Number(qiVideo.currentTime || 0) - baseOffset);
    }

    function renderSyncedLogs(relT) {
      if (!logBox) return;
      let activeIdx = 0;
      if (hasVideo) {
        for (let i = 0; i < tlLogs.length; i++) {
          if (Number(tlLogs[i].t || 0) <= relT + 0.25) activeIdx = i;
        }
      }
      const isPlaying = Boolean(qiVideo && !qiVideo.paused && !qiVideo.ended);
      const rows = tlLogs.map((item, i) => {
        const t = Number(item.t || 0);
        const isFuture = hasVideo && t > relT + 0.25;
        const cls = ['qi-log-line'];
        if (hasVideo && i === activeIdx) cls.push('active-time');
        else if (syncWithVideo && isPlaying && isFuture) cls.push('future-time');
        return `<div class="${cls.join(' ')}" data-t="${t}" title="点击跳转本场景视频 ${fmtTime(t)}"><span class="qi-log-ts">[${fmtTime(t)}]</span>${window.highlightLogHtml(item.line)}</div>`;
      });
      logBox.innerHTML = rows.join('');
      logBox.querySelectorAll('.qi-log-line').forEach(el => {
        el.addEventListener('click', () => {
          const seekRel = Number(el.dataset.t || 0);
          if (qiVideo && hasVideo) {
            seekQiVideo(baseOffset + seekRel, true);
          }
        });
      });
      if (syncWithVideo && activeIdx >= 0) {
        const actEl = logBox.querySelector('.qi-log-line.active-time');
        if (actEl) actEl.scrollIntoView({ block: 'nearest' });
      }
    }

    function updateSyncUi() {
      if (isClipMode && qiVideo && !qiVideo.paused && clipEndSec > baseOffset && qiVideo.currentTime >= clipEndSec) {
        qiVideo.pause();
      }
      const relT = getRelativeVideoTime();
      if (vidTimeBadge) {
        vidTimeBadge.style.display = hasVideo ? 'inline' : 'none';
        const spanLabel = fmtTime(sc.elapsed_s || (clipEndSec - baseOffset) || 0);
        vidTimeBadge.textContent = `${fmtTime(relT)} / ${spanLabel}`;
      }
      if (logSyncBtn) {
        logSyncBtn.style.display = hasVideo ? 'inline-flex' : 'none';
        logSyncBtn.textContent = syncWithVideo ? '⏱️ 视频↔日志联动中' : '📜 联动已暂停';
        logSyncBtn.style.borderColor = syncWithVideo ? 'var(--blue)' : 'var(--border)';
        logSyncBtn.style.color = syncWithVideo ? 'var(--blue)' : 'var(--text2)';
      }
      renderSyncedLogs(relT);
    }

    if (qiVideo) {
      qiVideo.ontimeupdate = updateSyncUi;
      qiVideo.onseeked = updateSyncUi;
      qiVideo.onplay = updateSyncUi;
      qiVideo.onpause = updateSyncUi;
    }
    if (logSyncBtn) {
      logSyncBtn.onclick = () => {
        syncWithVideo = !syncWithVideo;
        updateSyncUi();
      };
    }
    updateSyncUi();

    if (copyLogsBtn) {
      copyLogsBtn.onclick = () => {
        if (window.copyToClipboard) window.copyToClipboard(rawLogs);
      };
    }

    // Render recipe chain
    if (recipeChain) {
      const steps = sc.planned_steps || [];
      recipeChain.innerHTML = steps.map(s => `<span style="color:var(--text);font-weight:600;">${s.index}.${escapeHtml(s.title)}</span>`).join(' <span style="color:var(--blue);">&rarr;</span> ');
    }

    // Video & restore buttons (operate directly on in-place #qi-video when available)
    if (vidStartBtn) {
      vidStartBtn.style.display = hasVideo ? '' : 'none';
      vidStartBtn.textContent = isClipMode ? `🎬 播场景起点 (${sc.video_time_label || '00:00'})` : '🎬 从头播放本场景';
      vidStartBtn.onclick = () => {
        if (hasVideo) {
          seekQiVideo(baseOffset, true);
        } else if (window.seekVideoToScene) {
          window.seekVideoToScene(sc.video_offset_s || 0, sc.title);
        }
      };
    }
    if (vidHlBtn) {
      vidHlBtn.style.display = hasVideo ? '' : 'none';
      const rawHl = sc.video_highlight_s !== undefined ? Number(sc.video_highlight_s) : baseOffset;
      const effHlAbs = isClipMode ? rawHl : Math.max(0, Number(sc.elapsed_s || 0) - 4);
      const hlLabel = isClipMode ? (sc.video_highlight_label || sc.video_time_label || '00:00') : fmtTime(effHlAbs);
      vidHlBtn.textContent = `⚡ 直跳高光瞬间 (${hlLabel})`;
      vidHlBtn.onclick = () => {
        if (hasVideo) {
          seekQiVideo(effHlAbs, true);
        } else if (window.seekVideoToScene) {
          window.seekVideoToScene(rawHl, sc.title + ' [高光时刻]');
        }
      };
    }
    if (restoreBtn) {
      restoreBtn.onclick = () => {
        if (window.openRestoreForScene) window.openRestoreForScene(sc.scene_id);
      };
    }

    // Sync URL #scene=<scene_id> deep-link & share button + keep bottom restore selector aligned
    if (sc.scene_id && history.replaceState) {
      try {
        history.replaceState(null, '', '#scene=' + encodeURIComponent(sc.scene_id));
      } catch (_) {}
    }
    const restoreSel = document.getElementById('scene-id-select');
    if (restoreSel && sc.scene_id && restoreSel.value !== sc.scene_id) {
      const hasOpt = Array.from(restoreSel.options).some(o => o.value === sc.scene_id);
      if (hasOpt) {
        restoreSel.value = sc.scene_id;
        restoreSel.dispatchEvent(new Event('change'));
      }
    }
    const shareLinkBtn = document.getElementById('qi-share-link-btn');
    if (shareLinkBtn) {
      shareLinkBtn.onclick = () => {
        const deepUrl = location.href.split('#')[0] + '#scene=' + encodeURIComponent(sc.scene_id || '');
        if (window.copyToClipboard) {
          window.copyToClipboard(deepUrl);
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(deepUrl).catch(() => {});
        }
        const prevTxt = shareLinkBtn.textContent;
        shareLinkBtn.textContent = '✅ 已复制直达链接';
        setTimeout(() => { shareLinkBtn.textContent = prevTxt; }, 1800);
      };
    }

    inspector.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  function applySceneHashRoute() {
    const rawHash = (window.location.hash || '').replace(/^#/, '');
    if (!rawHash.startsWith('scene=')) return;
    const targetVal = decodeURIComponent(rawHash.slice('scene='.length)).trim();
    if (!targetVal) return;
    const list = getScenesList();
    if (!list.length) return;
    let foundIdx = list.findIndex(item => item && String(item.scene_id) === targetVal);
    if (foundIdx < 0 && /^\d+$/.test(targetVal)) {
      const oneBased = Number(targetVal) - 1;
      if (oneBased >= 0 && oneBased < list.length) foundIdx = oneBased;
    }
    if (foundIdx >= 0) {
      window.openQuickInspector(foundIdx, false);
    }
  }
  window.addEventListener('hashchange', applySceneHashRoute);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applySceneHashRoute, { once: true });
  } else {
    setTimeout(applySceneHashRoute, 0);
  }

  const prevBtn = document.getElementById('qi-prev-btn');
  const nextBtn = document.getElementById('qi-next-btn');
  const closeBtn = document.getElementById('qi-close-btn');
  if (prevBtn) prevBtn.addEventListener('click', () => stepQuickInspector(-1));
  if (nextBtn) nextBtn.addEventListener('click', () => stepQuickInspector(1));
  if (closeBtn) closeBtn.addEventListener('click', window.closeQuickInspector);

  // Keyboard shortcuts: ← / → / J / K / R / Esc when inspector is open (and lightbox is not active)
  document.addEventListener('keydown', (e) => {
    if (!inspector || !inspector.classList.contains('open')) return;
    const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
    const lb = document.getElementById('lightbox');
    if (lb && lb.classList.contains('active')) return;

    if (e.key === 'ArrowRight' || e.key === 'j' || e.key === 'J') {
      e.preventDefault();
      stepQuickInspector(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'k' || e.key === 'K') {
      e.preventDefault();
      stepQuickInspector(-1);
    } else if (e.key === 'r' || e.key === 'R') {
      e.preventDefault();
      const sc = getScenesList()[currentIdx];
      if (sc && window.openRestoreForScene) window.openRestoreForScene(sc.scene_id);
    } else if (e.key === 'Escape') {
      window.closeQuickInspector();
    }
  });
})();
</script>

{% if business_error %}
<section class="section" id="business-error" style="border-left:4px solid var(--red);padding:14px 18px;margin-bottom:16px;">
  <strong style="color:var(--red);">⚠️ 业务报告数据包校验失败：</strong>
  <span class="missing">{{ business_error }}</span>
</section>
{% endif %}

{% if business and not (scene and scene.is_multi_suite and scene.scenes) %}
<!-- 第一层：业务验收结论看板 (Business Verdict Hero) -->
<section class="section" id="business-overview" style="border-width:2px;">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:1.15rem;">📊 业务功能验收全景 · 综合判定：
      <span style="color:{{ 'var(--green)' if business.summary.status == 'PASS' else 'var(--amber)' }};">
        {{ '✅ 验收通过 (PASS)' if business.summary.status == 'PASS' else '⚠️ 存在异常待复现排查 (' ~ business.summary.status ~ ')' }}
      </span>
    </h2>
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <div style="font-size:.82rem;color:var(--text2);">
        首轮通过率 <b>{{ (business.summary.first_pass_rate * 100)|round(1) }}%</b> ·
        最终完成率 <b>{{ (business.summary.final_completion_rate * 100)|round(1) }}%</b> ·
        证据完整率 <b>{{ (business.summary.evidence_complete_rate * 100)|round(1) }}%</b>（声明 {{ business.summary.planned_steps }} 步）
      </div>
      <button type="button" class="scene-act-btn primary" style="flex:0 0 auto;" onclick="if(window.openRestoreForScene)window.openRestoreForScene('default')">📱 在真机上复现现场 &darr;</button>
    </div>
  </div>
  <p style="font-size:.84rem;color:var(--text2);margin-bottom:12px;">
    点击下方关键步骤缩略图可直接定位到对应步骤的断言、截图与录屏证据；所有原始失败与每次尝试均完整保留，如需在真机复现请点击右上角或页面底部的<strong>【真机现场复原工具箱】</strong>。
  </p>
  <div class="storyboard">
    {% for step in business.steps %}
    <a class="story-card" href="#{{ step.anchor }}">
      {% if step.screens %}
      <img class="story-screen" src="{{ step.screens[-1].url }}" alt="{{ step.title }}完整屏幕">
      {% else %}
      <div class="story-screen missing" style="display:flex;align-items:center;justify-content:center;">未采集完整屏幕</div>
      {% endif %}
      <div style="font-weight:700;font-size:.86rem;margin-bottom:4px;">步骤 {{ loop.index }}：{{ step.title }}</div>
      <div style="font-size:.76rem;color:{{ 'var(--green)' if step.final_result == 'PASS' else 'var(--red)' }};font-weight:600;">
        {{ '✔ 通过 (PASS)' if step.final_result == 'PASS' else '✖ 异常 (' ~ step.final_result ~ ')' }}
        {% if step.recovery_status %}<span style="color:var(--amber);"> · {{ step.recovery_status }}</span>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
</section>

<!-- 逐步骤验收详情与证据链 -->
<section class="section" id="business-steps">
  <div class="section-header" onclick="toggleSection(this)">
    🔍 逐步骤验收详情与底层证据链 ({{ business.steps|length }} 步)
    <span class="chevron">&#9660;</span>
  </div>
  <div class="section-body">
    <div class="business-layout">
      <nav class="business-nav">
        {% for step in business.steps %}
        <a href="#{{ step.anchor }}">
          <span style="color:{{ 'var(--green)' if step.final_result == 'PASS' else 'var(--red)' }};font-weight:700;">●</span>
          {{ loop.index }}. {{ step.title }}
        </a>
        {% endfor %}
      </nav>
      <div>
        {% for step in business.steps %}
        <article class="business-step" id="{{ step.anchor }}">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
            <h3 style="margin:0;font-size:1rem;">步骤 {{ loop.index }}：{{ step.title }} <span style="font-size:.8rem;color:var(--text2);font-weight:400;">({{ step.case_id }} / {{ step.business_step_id }})</span></h3>
            <span style="font-size:.82rem;font-weight:700;padding:3px 10px;border-radius:12px;background:{{ 'rgba(34,197,94,.14)' if step.final_result == 'PASS' else 'rgba(239,68,68,.14)' }};color:{{ 'var(--green)' if step.final_result == 'PASS' else 'var(--red)' }};">
              首次 {{ step.first_result }} &rarr; 最终 {{ step.final_result }}
              {% if step.recovery_status %} ({{ step.recovery_status }}){% endif %}
            </span>
          </div>
          {% if not step.attempts %}
          <p class="missing">NOT_RUN：该声明步骤未执行。</p>
          {% endif %}
          {% for attempt in step.attempts %}
          <details open style="margin-top:8px;">
            <summary style="cursor:pointer;font-weight:600;font-size:.85rem;color:var(--text2);">
              尝试 #{{ loop.index }} ({{ attempt.attempt_id }}) · 状态 {{ attempt.status }} · 耗时 {{ attempt.duration_ms }} ms
            </summary>
            <div class="attempt-grid">
              <div>
                {% for e in attempt.display_evidence if e.is_image %}
                  {% if e.available %}
                  <a href="{{ e.url }}" target="_blank"><img class="full-screen" src="{{ e.url }}" alt="{{ e.evidence_id }}原始全屏"></a>
                  {% else %}
                  <p class="missing">{{ e.error }}</p>
                  {% endif %}
                {% endfor %}
              </div>
              <div>
                <div style="font-size:.84rem;line-height:1.65;margin-bottom:10px;background:var(--surface);padding:10px 14px;border-radius:8px;">
                  <div><strong>前置条件：</strong>{{ attempt.preconditions }}</div>
                  <div><strong>执行动作：</strong>{{ attempt.action }}</div>
                  <div><strong>预期表现：</strong>{{ attempt.expected }}</div>
                  <div><strong>实际表现：</strong>{{ attempt.actual }}</div>
                  {% if attempt.error_message %}
                  <div class="missing" style="margin-top:4px;"><strong>异常诊断 ({{ attempt.failure_class }})：</strong>{{ attempt.error_message }}</div>
                  {% endif %}
                </div>
                <table class="mem-table assertions">
                  <thead><tr><th>断言维度</th><th>预期 / 实际结果</th><th>判定</th><th>关联证据</th></tr></thead>
                  <tbody>
                    {% for a in attempt.assertions %}
                    <tr>
                      <td style="font-weight:600;">{{ a.dimension }}</td>
                      <td>预期：{{ a.expected }}<br><span style="color:var(--text2);">实际：{{ a.actual }}</span></td>
                      <td><span style="font-weight:700;color:{{ 'var(--green)' if a.status == 'PASS' else 'var(--red)' }};">{{ a.status }}</span></td>
                      <td>{{ a.evidence_refs|join(', ') }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" class="missing">未采集结构化断言</td></tr>
                    {% endfor %}
                  </tbody>
                </table>
                {% for e in attempt.display_evidence %}
                <details style="margin-top:6px;font-size:.8rem;">
                  <summary style="cursor:pointer;color:var(--text2);">📎 证据材料：{{ e.evidence_id }} ({{ e.kind }} · {{ e.status }})</summary>
                  <div style="padding:8px 0;">
                    {% if e.available %}
                      <a href="{{ e.url }}" target="_blank">查看完整原始材料 &rarr;</a>
                      {% if e.preview %}<pre style="margin-top:6px;">{{ e.preview }}</pre>{% endif %}
                      {% if e.is_video %}
                      <video controls preload="metadata" style="max-width:100%;margin-top:6px;border-radius:8px;" src="{{ e.url }}{% if e.metadata.offset_s is defined %}#t={{ e.metadata.offset_s }}{% endif %}"></video>
                      {% endif %}
                    {% else %}
                      <p class="missing">{{ e.error or e.capture_error }}</p>
                    {% endif %}
                  </div>
                </details>
                {% endfor %}
              </div>
            </div>
          </details>
          {% endfor %}
        </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}
