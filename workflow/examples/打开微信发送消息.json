{
  "name": "打开微信发送消息",
  "device_serial": null,
  "clear_logcat_first": true,
  "final_collect_artifacts": true,
  "record_screen": false,
  "steps": [
    {
      "type": "clear_background_processes",
      "mode": "force_stop_3p",
      "run_kill_all_first": true,
      "comment": "确保手机处于干净状态"
    },
    {
      "type": "sleep",
      "seconds": 1.0
    },
    {
      "type": "launch_from_home",
      "query": "微信",
      "reset_home": true,
      "home_presses": 2,
      "wait_s": 3.0,
      "comment": "从桌面找到微信图标并点击"
    },
    {
      "type": "sleep",
      "seconds": 2.0,
      "comment": "等待微信完全加载"
    },
    {
      "type": "find_and_tap",
      "query": "通讯录",
      "scroll_on_fail": false,
      "comment": "切换到通讯录页面"
    },
    {
      "type": "sleep",
      "seconds": 1.0
    },
    {
      "type": "find_and_tap",
      "query": "文件传输助手",
      "scroll_on_fail": false,
      "comment": "点击文件传输助手进入聊天"
    },
    {
      "type": "sleep",
      "seconds": 1.0
    },
    {
      "type": "find_and_tap",
      "query": "请输入",
      "scroll_on_fail": false,
      "comment": "点击输入框"
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "type_text",
      "text": "这是一条测试消息"
    },
    {
      "type": "find_and_tap",
      "query": "发送",
      "scroll_on_fail": false,
      "comment": "发送消息"
    },
    {
      "type": "sleep",
      "seconds": 1.0
    },
    {
      "type": "screenshot",
      "name": "发送结果",
      "comment": "保存发送后的截图"
    },
    {
      "type": "key",
      "keycode": "KEYCODE_BACK",
      "comment": "返回上一页"
    }
  ]
}