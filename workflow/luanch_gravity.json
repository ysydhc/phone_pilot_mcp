{
    "name": "clear_and_launch_gravity",
    "device_serial": null,
    "clear_logcat_first": true,
    "final_collect_artifacts": false,
    "steps": [
      {
        "type": "clear_background_processes",
        "device_serial": null,
        "mode": "force_stop_3p",
        "exclude_packages": null,
        "max_packages": null,
        "run_kill_all_first": true
      },
      {
        "type": "launch_from_home",
        "device_serial": null,
        "query": "Gravity",
        "out_dir": "./recordings",
        "reset_home": true,
        "save_profile": false,
        "max_swipes": 2,
        "home_presses": 2,
        "wait_s": 1.0
      },
      {
        "type": "screenshot",
        "name": "gravity_opened"
      }
    ]
  }