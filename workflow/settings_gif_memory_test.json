{
  "name": "settings_gif_memory_test",
  "device_serial": null,
  "clear_logcat_first": true,
  "final_collect_artifacts": true,
  "record_screen": false,
  "steps": [
    {
      "type": "clear_background_processes",
      "mode": "force_stop_3p",
      "run_kill_all_first": true,
      "comment": "步骤1: 清空后台进程"
    },
    {
      "type": "launch_from_home",
      "query": "IMEDemo",
      "reset_home": true,
      "home_presses": 2,
      "wait_s": 2.0,
      "comment": "步骤2: 从桌面打开IMEDemo"
    },
    {
      "type": "sleep",
      "seconds": 1.5
    },
    {
      "type": "find_and_tap",
      "query": "设置键盘",
      "exact": false,
      "scroll_on_fail": false,
      "tap_offset_x": 50,
      "tap_offset_y": 100,
      "comment": "步骤3: 点击EditText（向下偏移50px以点击输入框）"
    },
    {
      "type": "sleep",
      "seconds": 1.5
    },
    {
      "type": "find_image_and_tap",
      "template_path": "/Users/yeshouyou/Work/agent/phone_touch/recordings/templates/keyboard_笑脸.png",
      "threshold": 0.65,
      "grayscale": true,
      "scroll_on_fail": false,
      "roi": [0, 900, 1080, 500],
      "comment": "步骤4: 点击键盘上的笑脸图案（ROI: x=0, y=900, w=1080, h=500，即屏幕中部键盘区域）"
    },
    {
      "type": "sleep",
      "seconds": 1.5
    },
    {
      "type": "find_image_and_tap",
      "template_path": "/Users/yeshouyou/Work/agent/phone_touch/recordings/templates/keyboard_gif.png",
      "threshold": 0.65,
      "grayscale": true,
      "scroll_on_fail": false,
      "roi": [0, 800, 1080, 1600],
      "comment": "步骤5: 点击GIF按钮（ROI: x=0, y=800, w=1080, h=1600，即屏幕中下部分）"
    },
    {
      "type": "sleep",
      "seconds": 2.0
    },
    {
      "type": "dump_hprof",
      "name": "before_gif_scroll",
      "var": "hprof_before",
      "fallback_to_meminfo": true,
      "comment": "步骤6: 第一次dump内存（优先hprof，失败则降级到meminfo）"
    },
    {
      "type": "screenshot",
      "name": "before_gif_search"
    },
    {
      "type": "find_and_tap",
      "query": "Why",
      "exact": false,
      "scroll_on_fail": false,
      "ocr_lang": "eng",
      "comment": "步骤7: 点击Why（UIAutomator 或 OCR 自动回退）"
    },
    {
      "type": "sleep",
      "seconds": 4.0,
      "comment": "步骤7续: 等待4秒"
    },
    {
      "type": "repeat",
      "count": 3,
      "comment": "步骤8: 滑动3次页面，每次等待5s，位置偏下",
      "steps": [
        {
          "type": "swipe",
          "x1_pct": 0.5,
          "y1_pct": 0.85,
          "x2_pct": 0.5,
          "y2_pct": 0.40,
          "duration_ms": 350,
          "wait_s": 0.3
        },
        {
          "type": "sleep",
          "seconds": 5.0
        }
      ]
    },
    {
      "type": "dump_hprof",
      "name": "after_gif_scroll",
      "var": "hprof_after",
      "fallback_to_meminfo": true,
      "comment": "步骤9: 第二次dump内存（优先hprof，失败则降级到meminfo）"
    },
    {
      "type": "screenshot",
      "name": "after_gif_scroll"
    }
  ]
}
